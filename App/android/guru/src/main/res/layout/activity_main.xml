<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <!-- App Toolbar Extended -->
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/app_bar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/sesl_action_bar_height_with_padding"
            android:background="@android:color/transparent"
            app:expanded="false"
            android:elevation="0dp"
            android:stateListAnimator="@null"
            app:statusBarForeground="@null"
            style="@style/Widget.Design.AppBarLayout">
            <!-- App Toolbar Collapsed -->
            <com.google.android.material.appbar.CollapsingToolbarLayout
                android:id="@+id/collapsing_toolbar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                app:layout_scrollFlags="scroll|exitUntilCollapsed">
                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/sesl_action_bar_height_with_padding"
                    android:layout_gravity="bottom"
                    android:background="@android:color/transparent"
                    android:visibility="invisible"/>
            </com.google.android.material.appbar.CollapsingToolbarLayout>
        </com.google.android.material.appbar.AppBarLayout>
        <!-- Fragments -->
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/nav_host_fragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior"/>
        <!-- Fade Top/Bottom -->
        <View
            android:id="@+id/fade_top"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_gravity="top"
            android:alpha="0"
            android:importantForAccessibility="no"/>
        <View
            android:id="@+id/fade_bottom"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_gravity="bottom"
            android:alpha="0"
            android:importantForAccessibility="no"/>
        <!-- Floating Toolbar (Top) -->
        <com.google.android.material.oneui.floatingactioncontainer.FloatingToolbarLayout
            android:id="@+id/sesl_floating_toolbar_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_anchor="@id/app_bar"
            app:skipAnimation="false">
            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?actionBarSize"
                android:layout_gravity="bottom"
                android:background="@android:color/transparent"/>
        </com.google.android.material.oneui.floatingactioncontainer.FloatingToolbarLayout>
        <!-- Floating Bottom Bar -->
        <com.google.android.material.oneui.floatingactioncontainer.FloatingBottomLayout
            android:id="@+id/sesl_floating_bottom_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center|bottom"
            app:skipAnimation="false">
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/bottom_tab"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                app:seslTabStyle="Main"
                style="@style/OneUI.BottomBar.TabLayout">
                <com.google.android.material.tabs.TabItem
                    android:icon="@drawable/ic_nav_device"
                    android:text="@string/tab_nav1"/>
                <com.google.android.material.tabs.TabItem
                    android:icon="@drawable/ic_nav_settings"
                    android:text="@string/tab_nav2"/>
                <com.google.android.material.tabs.TabItem
                    android:icon="@drawable/ic_nav_advanced"
                    android:text="@string/tab_nav3"/>
                <com.google.android.material.tabs.TabItem
                    android:icon="@drawable/ic_nav_about"
                    android:text="@string/tab_nav4"/>
            </com.google.android.material.tabs.TabLayout>
        </com.google.android.material.oneui.floatingactioncontainer.FloatingBottomLayout>
        <!-- Floating Bottom Search Bar -->
        <com.google.android.material.oneui.floatingactioncontainer.FloatingBottomLayout
            android:id="@+id/search_floating_bottom_layout"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center|bottom"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:visibility="gone"
            app:showFloatingItemBackground="false"
            app:enableScrollTransition="false"
            app:skipAnimation="false">
            <androidx.appcompat.widget.SearchView
                android:id="@+id/search_view"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                app:iconifiedByDefault="false"
                app:seslSearchViewApplyBlur="true"
                style="@style/OneUI.SearchView.Bottom"/>
        </com.google.android.material.oneui.floatingactioncontainer.FloatingBottomLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
    <View
        android:id="@+id/theme_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?roundedCornerColor"
        android:visibility="gone"/>
</FrameLayout>