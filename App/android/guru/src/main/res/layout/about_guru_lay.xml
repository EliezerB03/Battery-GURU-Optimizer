<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls"
        android:scrollbars="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingHorizontal="10dp">
        
            <!-- ====== About Battery GURU  ====== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sesl_action_bar_height_with_padding"
                android:gravity="center"
                android:orientation="vertical">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/about_app_icon_header"
                    android:layout_width="72dp"
                    android:layout_height="72dp"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="@string/app_name"
                    android:textSize="30sp"
                    android:textColor="@color/app_label_text_color"
                    app:fontFamily="@font/samsungsharpsans_bold"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/about_app_version_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="@string/about_appversion"
                    android:textSize="14sp"
                    android:textColor="@color/sesl_list_subheader_text_color"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/about_app_developer_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="@string/about_developer"
                    android:textSize="14sp"
                    android:textColor="@color/sesl_list_subheader_text_color"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:orientation="horizontal">
                    <androidx.appcompat.widget.AppCompatImageButton
                        android:id="@+id/github"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="8dp"
                        android:tint="?actionMenuTextColor"
                        android:background="?attr/actionBarItemBackground"
                        app:srcCompat="@drawable/ic_githubsource"/>
                    <androidx.appcompat.widget.AppCompatImageButton
                        android:id="@+id/developer"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:tint="?actionMenuTextColor"
                        android:background="?attr/actionBarItemBackground"
                        app:srcCompat="@drawable/ic_devcontact"/>
                </LinearLayout>
            </LinearLayout>

            <!-- ====== Updates ====== -->
            <com.guru.batteryoptimizer.widgets.SectionSeparator
                android:id="@+id/sep_updates"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/about_sep_updates"
                android:drawablePadding="8dp"
                android:drawableStart="@drawable/ic_updates"/>
            <androidx.appcompat.widget.SeslLinearLayoutCompat
                app:seslLayoutRoundedCorner="corner_all"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:colorBackground"
                android:orientation="vertical">
                <com.guru.batteryoptimizer.widgets.UpdatableWidget
                    android:id="@+id/check_update_widget"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:widgetMarginEnd="10dp"
                    app:showWidget="false">
                    <com.guru.batteryoptimizer.widgets.CardItemView
                        android:id="@+id/check_update"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:showTopDivider="false"
                        app:showBottomDivider="false"
                        app:title="@string/about_option_check_update"/>
                </com.guru.batteryoptimizer.widgets.UpdatableWidget>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?android:attr/listDivider"/>
                <com.guru.batteryoptimizer.widgets.CardItemView
                    android:id="@+id/changelog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:showTopDivider="false"
                    app:showBottomDivider="false"
                    app:title="@string/about_option_changelog"/>
            </androidx.appcompat.widget.SeslLinearLayoutCompat>

            <!-- ====== Import/Export ====== -->
            <com.guru.batteryoptimizer.widgets.SectionSeparator
                android:id="@+id/sep_importexport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/about_sep_importexport"
                android:drawablePadding="8dp"
                android:drawableStart="@drawable/ic_importexport"/>
            <androidx.appcompat.widget.SeslLinearLayoutCompat
                app:seslLayoutRoundedCorner="corner_all"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:colorBackground"
                android:orientation="vertical">
                <com.guru.batteryoptimizer.widgets.CardItemView
                    android:id="@+id/import_settings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:showTopDivider="false"
                    app:showBottomDivider="false"
                    app:title="@string/about_option_import"/>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?android:attr/listDivider"/>
                <com.guru.batteryoptimizer.widgets.CardItemView
                    android:id="@+id/export_settings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:showTopDivider="false"
                    app:showBottomDivider="false"
                    app:title="@string/about_option_export"/>
            </androidx.appcompat.widget.SeslLinearLayoutCompat>
            
            <!-- ====== Labs (Experimental) ====== -->
            <com.guru.batteryoptimizer.widgets.SectionSeparator
                android:id="@+id/sep_labs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/about_sep_labs"
                android:drawablePadding="8dp"
                android:drawableStart="@drawable/ic_labs"/>
            <androidx.appcompat.widget.SeslLinearLayoutCompat
                app:seslLayoutRoundedCorner="corner_all"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:colorBackground"
                android:orientation="vertical">
                <com.guru.batteryoptimizer.widgets.SwitchItemView
                    android:id="@+id/limitbackground_opt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:showTopDivider="false"
                    app:showBottomDivider="false"
                    app:title="@string/about_option_limitbackground"/>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?android:attr/listDivider"/>
                <com.guru.batteryoptimizer.widgets.SwitchItemView
                    android:id="@+id/forcedoze_opt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:showTopDivider="false"
                    app:showBottomDivider="false"
                    app:title="@string/about_option_forcedoze"/>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?android:attr/listDivider"/>
                <com.guru.batteryoptimizer.widgets.SwitchItemView
                    android:id="@+id/nsd_opt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:showTopDivider="false"
                    app:showBottomDivider="false"
                    app:title="@string/about_option_nsd"/>
            </androidx.appcompat.widget.SeslLinearLayoutCompat>
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/reset_settings"
                style="@style/OneUI.ContainedButton"
                android:layout_width="300dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:text="@string/about_button_reset_settings"
                android:theme="@style/OneUI.ContainedPrimaryColorButtonTheme"/>
            <!-- ====== SpaceBottom Reserved ====== -->
            <View
                android:id="@+id/fragment_tail_space"
                android:layout_width="match_parent"
                android:layout_height="120dp"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>