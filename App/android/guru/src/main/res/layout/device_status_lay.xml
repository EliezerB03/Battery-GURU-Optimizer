<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls"
        android:scrollbars="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingHorizontal="10dp">

            <!-- ====== CPU usage ====== -->
            <dev.oneuiproject.oneui.widget.Separator
                android:id="@+id/sep_cpu_usage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/device_sep_cpu_usage"
                android:drawablePadding="8dp"
                android:drawableStart="@drawable/ic_cpu"/>
            <dev.oneuiproject.oneui.widget.RoundedLinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:colorBackground"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/device_cpu_ecores"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="14sp"
                    android:paddingStart="17dp"
                    android:paddingEnd="17dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="4dp"/>
                <LinearLayout
                    android:id="@+id/e_cores_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"/>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?android:attr/listDivider"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/device_cpu_pcores"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="14sp"
                    android:paddingStart="17dp"
                    android:paddingEnd="17dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="4dp"/>
                <LinearLayout
                    android:id="@+id/p_cores_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"/>
            </dev.oneuiproject.oneui.widget.RoundedLinearLayout>

            <!-- ====== GPU usage ====== -->
            <dev.oneuiproject.oneui.widget.Separator
                android:id="@+id/sep_gpu_usage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/device_sep_gpu_usage"
                android:drawablePadding="8dp"
                android:drawableStart="@drawable/ic_gpu"/>
            <dev.oneuiproject.oneui.widget.RoundedLinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:colorBackground"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="8dp"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/device_gpu_core"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="14sp"
                        android:gravity="start"/>
                    <TextView
                        android:id="@+id/gpu_freq"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="N/A"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="14sp"
                        android:gravity="center"/>
                    <TextView
                        android:id="@+id/gpu_percent"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="---%"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:gravity="end"/>
                </LinearLayout>
                <androidx.appcompat.widget.SeslProgressBar
                    android:id="@+id/gpu_progress"
                    style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:indeterminate="false"
                    android:paddingHorizontal="15dp"
                    android:layout_marginBottom="12dp"
                    android:max="100"
                    android:progress="0"/>
            </dev.oneuiproject.oneui.widget.RoundedLinearLayout>

            <!-- ====== Memory usage ====== -->
            <dev.oneuiproject.oneui.widget.Separator
                android:id="@+id/sep_memory_usage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/device_sep_memory_usage"
                android:drawablePadding="8dp"
                android:drawableStart="@drawable/ic_memory"/>
            <dev.oneuiproject.oneui.widget.RoundedLinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:colorBackground"
                android:orientation="vertical">
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <dev.oneuiproject.oneui.widget.CardItemView
                        android:id="@+id/show_memory"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:showTopDivider="false"
                        app:showBottomDivider="false"
                        app:title="@string/device_option_show_memory"/>
                    <androidx.appcompat.widget.AppCompatSpinner
                        android:id="@+id/spinner_memory"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:visibility="invisible"/>
                </FrameLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?android:attr/listDivider"/>
                <LinearLayout
                    android:id="@+id/memory_usage_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"/>
            </dev.oneuiproject.oneui.widget.RoundedLinearLayout>

            <!-- ====== Thermal ====== -->
            <dev.oneuiproject.oneui.widget.Separator
                android:id="@+id/sep_thermal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/device_sep_thermal_status"
                android:drawablePadding="8dp"
                android:drawableStart="@drawable/ic_thermal"/>
            <dev.oneuiproject.oneui.widget.RoundedLinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:colorBackground"
                android:orientation="vertical">
                <dev.oneuiproject.oneui.widget.SwitchItemView
                    android:id="@+id/switch_fahrenheit_unit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:showTopDivider="false"
                    app:showBottomDivider="false"
                    app:title="@string/device_option_usefahrenheit"/>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?android:attr/listDivider"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="17dp"
                    android:paddingEnd="17dp"
                    android:paddingTop="15dp"
                    android:paddingBottom="15dp"
                    app:showBottomDivider="true">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/device_cputemp"
                        android:gravity="start"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="14sp"/>
                    <TextView
                        android:id="@+id/tv_cpu_temp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="N/A"
                        android:gravity="end"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="14sp"
                        android:textStyle="bold"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="17dp"
                    android:paddingEnd="17dp"
                    android:paddingBottom="15dp"
                    app:showBottomDivider="true">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/device_gputemp"
                        android:gravity="start"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="14sp"/>
                    <TextView
                        android:id="@+id/tv_gpu_temp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="N/A"
                        android:gravity="end"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="14sp"
                        android:textStyle="bold"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="17dp"
                    android:paddingEnd="17dp"
                    android:paddingBottom="15dp"
                    app:showBottomDivider="false">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/device_batterytemp"
                        android:gravity="start"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="14sp"/>
                    <TextView
                        android:id="@+id/tv_battery_temp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="N/A"
                        android:gravity="end"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="14sp"
                        android:textStyle="bold"/>
                </LinearLayout>
            </dev.oneuiproject.oneui.widget.RoundedLinearLayout>

            <!-- ====== Battery info ====== -->
            <dev.oneuiproject.oneui.widget.Separator
                android:id="@+id/sep_battery_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/device_sep_battery_status"
                android:drawablePadding="8dp"
                android:drawableStart="@drawable/ic_battery_info"/>
            <dev.oneuiproject.oneui.widget.RoundedLinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:colorBackground"
                android:orientation="vertical">
                <dev.oneuiproject.oneui.widget.CardItemView
                    android:id="@+id/battery_cap"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:showTopDivider="false"
                    app:showBottomDivider="false"
                    app:title="@string/device_batterycap"/>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?android:attr/listDivider"/>
                <dev.oneuiproject.oneui.widget.CardItemView
                    android:id="@+id/battery_health"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:showTopDivider="false"
                    app:showBottomDivider="false"
                    app:title="@string/device_batteryhealth"/>
            </dev.oneuiproject.oneui.widget.RoundedLinearLayout>

            <!-- ====== Separator ====== -->
            <dev.oneuiproject.oneui.widget.Separator
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>