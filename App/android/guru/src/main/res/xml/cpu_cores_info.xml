<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingStart="15dp"
    android:paddingEnd="15dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    app:showBottomDivider="true">
    <!-- Left Item -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingEnd="8dp">
        <androidx.appcompat.widget.SeslProgressBar
            android:id="@+id/core_progress_left"
            style="@style/Widget.AppCompat.ProgressBar.Xlarge"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminate="false"
            android:max="100"
            android:progress="0"/>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">
            <TextView
                android:id="@+id/core_name_left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/device_cpu_cores"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="14sp"/>
            <TextView
                android:id="@+id/core_freq_left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="N/A"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="14sp"/>
            <TextView
                android:id="@+id/core_percent_left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="---%"
                android:textColor="?attr/colorPrimary"
                android:textSize="14sp"
                android:textStyle="bold"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Right Item -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp">
        <androidx.appcompat.widget.SeslProgressBar
            android:id="@+id/core_progress_right"
            style="@style/Widget.AppCompat.ProgressBar.Xlarge"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminate="false"
            android:max="100"
            android:progress="0"/>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">
            <TextView
                android:id="@+id/core_name_right"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/device_cpu_cores"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="14sp"/>
            <TextView
                android:id="@+id/core_freq_right"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="N/A"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="14sp"/>
            <TextView
                android:id="@+id/core_percent_right"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="---%"
                android:textColor="?attr/colorPrimary"
                android:textSize="14sp"
                android:textStyle="bold"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>