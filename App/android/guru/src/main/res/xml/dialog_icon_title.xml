<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="@dimen/sesl_dialog_padding_horizontal"
    android:paddingEnd="@dimen/sesl_dialog_padding_horizontal"
    android:paddingTop="@dimen/sesl_dialog_title_padding_top"
    android:paddingBottom="@dimen/sesl_dialog_title_padding_bottom">
    <TextView
        android:id="@+id/dialog_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="@dimen/sesl_dialog_title_text_size"
        android:textStyle="bold"
        android:textColor="?android:attr/textColorPrimary" />
</LinearLayout>